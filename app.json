{
  "expo": {
    "name": "Arama Yönetim Sistemi",
    "slug": "arama-yonetim-sistemi",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/app-icon-2026.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["./plugins/withCrashInfo"],
    "splash": {
      "image": "./assets/app-icon-2026.png",
      "resizeMode": "contain",
      "backgroundColor": "#171920"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-2026.png",
        "backgroundColor": "#171920"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.ardagnl.aramayonetim",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            { "mimeType": "application/json" },
            { "mimeType": "application/octet-stream" },
            { "mimeType": "text/plain" },
            { "mimeType": "application/x-arama-yonetim" }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/app-icon-2026.png",
      "bundler": "metro",
      "name": "Arama Yönetim Sistemi",
      "shortName": "Arama Sistemi",
      "description": "Anket ve arama yönetim uygulaması",
      "backgroundColor": "#171920",
      "themeColor": "#266798"
    },
    "experiments": {
      "baseUrl": "/Arama-Yonetim-Sistemi"
    },
    "extra": {
      "eas": {
        "projectId": "380df80f-d25c-49ed-bdd2-7f577371ea4e"
      }
    }
  }
}
